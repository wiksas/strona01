---
layout: null
---
{%- include zmienne.html -%}
{%- capture obrazy -%}
{{ F.og_obraz }}|{% for id in ids %}{% assign s = site.data.sezony[id] %}{{ s.hero_glowne.obraz }}|{{ s.hero_polaroid.obraz }}|{{ s.spacer_obraz.obraz }}|{% for k in s.karty %}{{ k.obraz }}|{% endfor %}{% endfor %}{% for z in P.galeria.zdjecia %}{{ z.obraz }}|{% endfor %}{{ P.przestrzen.obraz }}|{{ P.przyjecia.obraz_glowny }}|{{ P.przyjecia.obraz_boczny }}|{{ P.kontakt.mapa }}
{%- endcapture -%}
{%- assign lista = obrazy | split: '|' | uniq -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
  <url>
    <loc>{{ base }}</loc>
    <lastmod>{{ site.time | date: '%Y-%m-%d' }}</lastmod>
    {%- for o in lista %}{% if o != '' %}
    <image:image><image:loc>{{ o | absolute_url }}</image:loc></image:image>
    {%- endif %}{% endfor %}
  </url>
</urlset>
